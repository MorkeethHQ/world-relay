NEXT_PUBLIC_WORLD_APP_ID=app_your_app_id_here
ANTHROPIC_API_KEY=sk-ant-your-key-here
DEV_PORTAL_API_KEY=
WLD_CLIENT_SECRET=
XMTP_WALLET_KEY=0x_your_bot_private_key_here

# --- Privilege gates (both ship dormant; flip to "true" to enforce) ---
# Wallet identity on mutating routes must match the session cookie (invariant 4).
SESSION_ENFORCE=false
# Seeding privilege must come from the x-seed-secret header rather than an
# "agent:"-prefixed poster string. Flip to "true" ONLY after the seeding caller
# sends the header, otherwise seeded campaign tasks start hitting the throttle.
# While false, look for "[seed] LEGACY EXEMPTION" in logs: each one is a request
# that would be denied after the flip.
SEED_AUTH_ENFORCE=false
# Shared secret for authenticated seeding (x-seed-secret) and admin ops.
ADMIN_SECRET=
