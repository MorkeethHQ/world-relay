# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# xmtp local db
*.db3
*.db3.*

# local sqlite databases — never commit runtime data
data/*.db
*.db
*.db-shm
*.db-wal

# ad-hoc git worktrees created by agent tooling
/.worktrees/

# hand-made script backups (name your rollback with git, not a .bak file)
*.bak-*

# foundry build artifacts
contracts/out/
contracts/cache/
contracts/lib/openzeppelin-contracts-upgradeable/

# sub-packages
mcp-server/node_modules/
mcp-server/package-lock.json
sdks/python/__pycache__/
sdks/python/*.egg-info/
sdks/python/**/__pycache__/
scripts/.pulse-state.json
scripts/.*.log
pulse.log

# ops scratch state, rewritten every watch run
scripts/.watch-state.json
